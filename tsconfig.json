{
  "compilerOptions": {
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/app/*": ["./app/*"],
      "@/lib/*": ["./lib/*"],
      "@/lib/actions/*": ["./lib/actions/*"],
      "@/lib/utils/*": ["./lib/utils/*"],
      "@/assets/*": ["./assets/*"],
      "@/components/*": ["./components/*"],
      "@/types": ["./types.ts"],
      "@/styles/*": ["./styles/*"],
      "@/i18n/*": ["./i18n/*"],
      "@/types/*": ["./types/*"]
    },
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext", "ES2022"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "i18n/**/*.ts",
    "messages/**/*.json",
    "types/**/*.ts",
    "*.ts",
    "*.mts",
    "next-env.d.ts",
    "next.config.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-pixb/performance/types/**/*.ts",
    ".next-pixb/performance/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "tests/**/*"]
}
