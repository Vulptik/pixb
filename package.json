  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/dev-local.mjs",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "start": "node .next/standalone/server.js",
    "format": "prettier . -w",
    "format:check": "prettier . --check",
    "update": "npx npm-check-updates -u",
    "prisma": "prisma",
    "db:generate": "prisma generate",
    "db:init": "node scripts/deploy-schema.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:studio": "prisma studio",
    "hash:password": "tsx scripts/hash-password.ts",
    "pretest": "prisma generate",
    "test": "vitest run",
    "pretest:coverage": "prisma generate",
    "test:coverage": "vitest run --coverage",
    "local:prepare": "node scripts/dev-local.mjs --prepare",
    "maintenance": "tsx scripts/maintenance.ts",
    "test:local": "node scripts/dev-local.mjs --exec node_modules/tsx/dist/cli.mjs scripts/check-local.ts",
    "benchmark:local": "node scripts/dev-local.mjs --exec node_modules/tsx/dist/cli.mjs scripts/benchmark-local.ts"
  },
  "overrides": {
