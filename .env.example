# Copy to .env for a fresh install using compose.production.yml.
# Use the client-facing HTTP or HTTPS origin, including the port if needed.
PUBLIC_URL=http://localhost:3010

# Defaults for the app's host binding.
# PIXB_BIND_ADDRESS=127.0.0.1
# PIXB_PORT=3010

# Image versions. Change PIXB_VERSION to upgrade; change the database version only when the
# release notes say so.
# PIXB_VERSION=1.0.0
# PIXB_DATABASE_VERSION=1.0.0

# init-config generates and persists installation secrets. See docs/self-hosting.md.
# npm run dev generates its own local environment and needs no .env file.
